# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

DATABASE_URL=postgresql://postgres:admin@localhost:5432/medassist
SECRET_KEY=change-me-to-a-long-random-string

# ── LLM ────────────────────────
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60

# ── Embedding ──────────────────
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

RAG_RETRIEVAL_K=4
RAG_HISTORY_MESSAGES=4

CHROMA_PATH=./chroma_db
UPLOAD_DIR=./uploads

# ── MQTT ───────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=medassist/salle
MQTT_CLIENT_ID=medassist-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
