# ── Base de données Postgres ─────────────────────────────
POSTGRES_DB=medassist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:admin@postgres:5432/medassist

# ── Sécurité JWT ─────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM : Groq ───────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60

# ── Embeddings : OpenRouter ──────────────────────────────
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ── RAG ──────────────────────────────────────────────────
RAG_RETRIEVAL_K=4
RAG_HISTORY_MESSAGES=4

CHROMA_PATH=/data/chroma
UPLOAD_DIR=/data/uploads

# ── MQTT (ingestion capteurs IoT / ESP32) ────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=medassist/salle
MQTT_CLIENT_ID=medassist-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30