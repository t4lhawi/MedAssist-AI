# ════════════════════════════════════════════════════════
#  MedAssist AI – Configuration
#  Copier ce fichier en .env à la racine puis :
#      docker compose up --build -d
#  Les valeurs par défaut fonctionnent avec docker-compose.yml.
# ════════════════════════════════════════════════════════

# ── Base de données Postgres ─────────────────────────────
POSTGRES_DB=medassist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:admin@postgres:5432/medassist

# ── Sécurité JWT ─────────────────────────────────────────
SECRET_KEY=7f3a9c1e8b2d4f6a0c5e9b7d3f1a8c6e4b2d9f7a1c3e5b8d0f2a4c6e8b1d3f5a
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── IA : Ollama (GRATUIT, tout local, pas de quota) ───────
# Démarre Ollama sur ta machine (`ollama serve`) puis :
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
# Si tu utilises docker-compose, l'URL est http://ollama:11434.
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_MODEL=nomic-embed-text
RAG_RETRIEVAL_K=4
RAG_HISTORY_MESSAGES=4

# ─────────────────────────────────────────────────────────
# Modèles Ollama alternatifs (changer LLM_MODEL et `ollama pull <model>`) :
#   llama3.1:8b         meilleur que 3.2 en français/medical (~5 GB)
#   mistral             7B, bon multi-tâche
#   qwen2.5:7b          multilingue
#   llama3.1:70b        très bon mais ~40 GB RAM
#
# Embeddings alternatifs :
#   nomic-embed-text    défaut, 768-dim, bien supporté
#   mxbai-embed-large   1024-dim, multilingue, plus lent

# Chemins persistants côté conteneur (volumes montés par compose).
CHROMA_PATH=/data/chroma
UPLOAD_DIR=/data/uploads

# ── MQTT (ingestion capteurs IoT / ESP32) ────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=medassist/salle
MQTT_CLIENT_ID=medassist-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
