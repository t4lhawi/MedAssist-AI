# ════════════════════════════════════════════════════════
#  MedAssist AI – Configuration
#  Copier ce fichier en .env à la racine puis :
#      docker compose up --build -d
#  Les valeurs par défaut fonctionnent avec docker-compose.yml.
# ════════════════════════════════════════════════════════

# ── Base de données Postgres ─────────────────────────────
POSTGRES_DB=medassist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:admin@postgres:5432/medassist

# ── Sécurité JWT ─────────────────────────────────────────
SECRET_KEY=7f3a9c1e8b2d4f6a0c5e9b7d3f1a8c6e4b2d9f7a1c3e5b8d0f2a4c6e8b1d3f5a
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── IA : Ollama (GRATUIT, tout local — par défaut) ───────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=30m
RAG_RETRIEVAL_K=4
RAG_HISTORY_MESSAGES=4

# ─────────────────────────────────────────────────────────
# Alternatives gratuites (décommentez si besoin) :
#
# Option A : Google Gemini (gratuit jusqu'à 1500 req/jour)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=
#
# Option B : Groq (gratuit, ultra-rapide)
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-8b-8192
# GROQ_API_KEY=
#
# Option C : OpenAI / OpenRouter
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Chemins persistants côté conteneur (volumes montés par compose).
CHROMA_PATH=/data/chroma
UPLOAD_DIR=/data/uploads

# ── MQTT (ingestion capteurs IoT / ESP32) ────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=medassist/salle
MQTT_CLIENT_ID=medassist-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
