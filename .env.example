# ════════════════════════════════════════════════════════
#  MedAssist AI – Configuration
#  Copier ce fichier en .env et adapter les valeurs
# ════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────
POSTGRES_DB=medassist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:admin@localhost:5432/medassist

# ── Sécurité JWT ─────────────────────────────────────────
SECRET_KEY=7f3a9c1e8b2d4f6a0c5e9b7d3f1a8c6e4b2d9f7a1c3e5b8d0f2a4c6e8b1d3f5a

# ── IA : Ollama (GRATUIT, tout local) ────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://ollama:11434

# ─────────────────────────────────────────────────────────
# Alternatives gratuites (décommentez si besoin) :
#
# Option A : Google Gemini (gratuit jusqu'à 1500 req/jour)
#   → https://aistudio.google.com/app/apikey (inscription gratuite)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=votre_cle_ici
#
# Option B : Groq (gratuit, ultra-rapide)
#   → https://console.groq.com (inscription gratuite)
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-8b-8192
# GROQ_API_KEY=votre_cle_ici
# ─────────────────────────────────────────────────────────

# ── Ne pas modifier ──────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
